# BuimbPay Environment Variables
NODE_ENV=development
PORT=4000
API_URL=http://localhost:4000
WEB_URL=http://localhost:3000
DASHBOARD_URL=http://localhost:5173

# Public Web Environment Variables
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_DASHBOARD_URL=http://localhost:5173

# Database & Cache
DATABASE_URL="postgresql://buimbpay:buimbpay_dev_secret@localhost:5432/buimbpay_dev"
REDIS_URL="redis://:buimbpay_redis_secret@localhost:6379"

# Security & Secrets
JWT_SECRET="buimbpay_dev_super_secret_jwt_signing_key_32_bytes_min!"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"
ENCRYPTION_KEY="0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef"

# Settlement Fee & Tax Configuration (BPS = basis points, 100 bps = 1.00%)
# NOTE: Placeholder/illustrative values pending a real merchant fee-plan model.
# DO NOT mistake these for real business pricing.
SETTLEMENT_FEE_BPS=200
SETTLEMENT_TAX_ON_FEE_BPS=1800

# Production Payment Guard (ALWAYS false in dev/sandbox)
# Production payment processing remains disabled until all regulatory, banking, and PCI requirements are fulfilled.
PAYMENT_PRODUCTION_ENABLED=false

# Allowed Origins (CORS)
ALLOWED_ORIGINS="http://localhost:3000,http://localhost:5173"
